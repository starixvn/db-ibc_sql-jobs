    <DTS:Executable
      DTS:refId="Package\End Rountine Package"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="End SQL Rountine Task"
      DTS:DTSID="{2911AD9C-4212-489A-BC42-576E73A57BB4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="End Rountine Package"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{118C734F-0EF6-4E4E-8D13-3A8AEDC523AA}"
          SQLTask:SqlStatementSource="declare @runtimeID int, @error int, @message varchar(250), @rowTotal int, @fileID int;&#xA;set @runtimeID=?;&#xA;set @error=?;&#xA;set @message=?;&#xA;set @rowTotal =?;&#xA;set @fileID=?;&#xA;&#xA;update rt with(rowlock,updlock)&#xA;set rt.Error = @error, rt.[Status] = CASE WHEN @error&gt;0 then 'Failed' else 'Completed' end&#xA;, rt.Message = @message&#xA;, rt.EndTime = getdate()&#xA;,rt.RowTotal=@rowTotal&#xA;from [dbo].[SSIS_PackageRuntime] rt&#xA;where rt.RuntimeID=@runtimeID;&#xA;&#xA;update df with(rowlock,updlock)&#xA;set DR_Status=CASE WHEN @error=0 then 1 else 0 end&#xA;from [dbo].[SSIS_DynamicMapping_OutputFile] df&#xA;where df.FileID=@fileID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::runtimeID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::error"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::message"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::rowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::fileID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Process Setting"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Process Setting Task"
      DTS:DTSID="{96DC4DD7-1101-4175-A6D4-A9563C2F5306}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Process Setting"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{118C734F-0EF6-4E4E-8D13-3A8AEDC523AA}"
          SQLTask:SqlStatementSource="declare @env varchar(10), @packageName varchar(100);&#xA;&#xA;set @env=?;&#xA;set @packageName=?;&#xA;&#xA;SELECT top(1) p.[PackageID], dt.ID AS SourceID, dt.TableName, df.FileID, df.FileName&#xA;FROM [dbo].[SSIS_Package] p with(nolock)&#xA;inner join dbo.SSIS_Package_ENV e with(nolock) on e.[PackageID] = p.PackageID&#xA;inner join dbo.SSIS_DynamicMapping_Package pt with(nolock) on pt.PackageID = p.PackageID&#xA;inner join dbo.SSIS_DynamicMapping dt with(nolock) on dt.ID = pt.DynamicMappingID&#xA;inner join [dbo].[SSIS_DynamicMapping_OutputFile] df with(nolock) on df.DynamicMappingID = dt.ID&#xA;where p.PackageName = @packageName&#xA;&#x9;and e.Environment = @env&#xA;&#x9;and DR_Status = 0&#xA;order by df.FileID ASC"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::packageID" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::sourceID" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="2"
            SQLTask:DtsVariableName="User::sourceTable" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="3"
            SQLTask:DtsVariableName="User::fileID" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="4"
            SQLTask:DtsVariableName="User::outputFileName" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::Environment"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="System::PackageName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
