    <DTS:Executable
      DTS:refId="Package\Start Rountine Package"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Start SQL Rountine Task"
      DTS:DTSID="{CC3EEC3C-7A49-49F9-84C2-11676DE9170D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Start Rountine Package"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{118C734F-0EF6-4E4E-8D13-3A8AEDC523AA}"
          SQLTask:SqlStatementSource="declare @packageID int, @sourceID int, @env varchar(10), @outputFilename varchar(250), @targetInfo varchar(100), @creattor varchar(100), @runtimeID int;&#xA;set @packageID=?;&#xA;set @sourceID=?;&#xA;set @env=?;&#xA;set @outputFilename=?;&#xA;set @targetInfo=?;&#xA;set @creattor=?;&#xA;&#xA;INSERT INTO [dbo].[SSIS_PackageRuntime]&#xA;        ([PackageID]&#xA;        ,[DynamicMappingID]&#xA;        ,[Environment]&#xA;        ,[Command]&#xA;        ,[TargetInfo]&#xA;        ,[StartTime]&#xA;        ,[Creator],[Status])&#xA;select p.[PackageID]&#xA;        ,@sourceID AS [DynamicMappingID]&#xA;        ,@env AS [Environment]&#xA;        ,@outputFilename AS [Command]&#xA;        ,@targetInfo AS [TargetInfo]&#xA;        ,GETDATE() AS [StartTime]&#xA;        ,@creattor AS [Creator], 'Running' AS [Status]&#xA;FROM dbo.SSIS_Package p with(nolock)&#xA;WHERE p.PackageID=@packageID;&#xA;&#xA;set @runtimeID=SCOPE_IDENTITY();&#xA;&#xA;select @runtimeID AS RuntimeID, 0 as error, '' as [message];"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::runtimeID" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::error" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="2"
            SQLTask:DtsVariableName="User::message" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::packageID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::sourceID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="$Project::Environment"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::outputFileName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::targetInfo"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="5"
            SQLTask:DtsVariableName="System::UserName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Validate Mapping File"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Validate Mapping File"
      DTS:DTSID="{DAB2355C-A7AE-4C11-8254-45BD43E956C7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Validate Mapping File"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{118C734F-0EF6-4E4E-8D13-3A8AEDC523AA}"
          SQLTask:SqlStatementSource="declare @sourceID int,@env varchar(10);&#xA;set @sourceID=?;&#xA;set @env=?;&#xA;&#xA;select dt.TableName as SourceTable, dt.BatchSize, dt.ChunkSize, tr.TargetServer+'#'+tr.TargetDB+'#'+tr.TargetTable AS TargetInfo&#xA;from [dbo].[SSIS_DynamicMapping_Target] tr with(nolock)&#xA;inner join dbo.SSIS_DynamicMapping dt with(nolock) on dt.ID = tr.DynamicMappingID&#xA;where tr.DynamicMappingID = @sourceID&#xA;and tr.Environment = @env&#xA;and tr.Active = 1;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::sourceTable" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::batchSize" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="2"
            SQLTask:DtsVariableName="User::chunkSize" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="3"
            SQLTask:DtsVariableName="User::targetInfo" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::sourceID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Project::Environment"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
