      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{330E61D2-1A1F-41CC-8A40-D4D415B9827A}"
          SQLTask:SqlStatementSource="DECLARE @sessionID INT, @isClosed BIT;&#xA;SET @sessionID=?;&#xA;WHILE 1=1 &#xA;BEGIN &#xA;&#x9;IF EXISTS(SELECT 1&#xA;&#x9;&#x9;FROM dbo.SSIS_PackageRuntime WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE RuntimeID=@sessionID AND Status='Closed')&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;SET @isClosed=1;&#xA;&#x9;&#x9;BREAK;&#xA;&#x9;END&#xA;&#x9;ELSE &#xA;&#x9;&#x9;WAITFOR DELAY '00:01:00'&#xA;END&#xA;SELECT @isClosed AS [IsClosed]"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::IsClosed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::SessionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
