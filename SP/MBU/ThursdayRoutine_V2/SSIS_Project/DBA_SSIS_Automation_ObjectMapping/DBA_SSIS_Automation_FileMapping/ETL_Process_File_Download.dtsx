              SQLTask:Connection="{F237F3BC-5862-4545-AD62-D4DD0CF8FD14}"
              SQLTask:SqlStatementSource="EXEC dbo.SSIS_DR_DynamicMapping_DownloadFile @DownloadPath=?,@FileName=?,@SessionID=?,@TableName=?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="$Project::DownloadDirectory"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
