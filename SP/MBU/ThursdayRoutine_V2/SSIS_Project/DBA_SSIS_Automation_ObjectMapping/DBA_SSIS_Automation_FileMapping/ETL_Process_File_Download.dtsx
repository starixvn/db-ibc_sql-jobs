            <FileSystemData
              TaskOverwriteDestFile="True"
              TaskSourcePath="User::serverFile"
              TaskIsSourceVariable="True"
              TaskDestinationPath="$Project::DownloadDirectory"
              TaskIsDestinationVariable="True" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach FileServer Files\Extract Compress File"
