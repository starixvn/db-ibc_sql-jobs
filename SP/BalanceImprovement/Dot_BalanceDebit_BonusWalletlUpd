CREATE PROCEDURE [dbo].[Dot_BalanceDebit_BonusWalletlUpd]
(
	@custID			INT,
	@bonusId		INT,
	@balance		MONEY,
	@Bonus			MONEY = 0 OUTPUT,
	@LockedAmt		MONEY = 0 OUTPUT,
	@CombinedBonus	MONEY = 0 OUTPUT,
	@errCode		INT = 0 OUTPUT	
)
AS
/*
	Created: 20170505@Bobby
	Task: 72789 - Implement bonus wallet into balance
	DB: DBTXN/bodb02
		
	Revisions:
		
	Params explanation
*/

BEGIN
	SET NOCOUNT ON 
	
	SELECT @errCode 	= 0
		,@CombinedBonus	= 0
		,@Bonus 		= 0
		,@LockedAmt		= 0
	
	BEGIN TRY
		--UPDATE into bonus debit table
		UPDATE bd WITH(ROWLOCK, UPDLOCK)
		SET @Bonus 			= bc.initBonus + bc.Bonus - (bd.bonus + @balance)
			,@LockedAmt 	= bc.initLockedAmt + bc.LockedAmt - bd.LockedAmt
			,@CombinedBonus = @Bonus + @LockedAmt
			,bonus	 		+= @balance
			
		FROM dbo.BonusWalletDebit bd 
			INNER JOIN dbo.BonusWalletCredit bc WITH(NOLOCK)
			ON bd.custID 	= bc.custID
			AND bd.bonusId 	= bc.bonusId
				
		WHERE bd.custID 	= @custID
			AND bd.bonusId 	= @bonusId
			
		IF(@@ROWCOUNT = 0)
			SET @errCode = 104
	END TRY
	BEGIN CATCH
		SET @errCode = 103
		
		INSERT INTO BalanceErr ( Custid, BalanceGroup, BalanceAmt, ExecutedSP, ErrMsg )
		VALUES ( @custid, 1, @balance,'Dot_BalanceDebit_BonusWalletlUpd',LEFT(ERROR_MESSAGE(),500))
		
	END CATCH 
	RETURN
END
